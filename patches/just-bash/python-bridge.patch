@@ -0,0 +1,256 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import { describe, expect, it } from "vitest";
+import { InMemoryFs } from "../../fs/in-memory-fs/in-memory-fs.js";
+import { BridgeHandler } from "./bridge-handler.js";
+import {
+  createSharedBuffer,
+  Flags,
+  OpCode,
+  type OpCodeType,
+  ProtocolBuffer,
+  Status,
+} from "./protocol.js";
+import { SyncBackend } from "./sync-backend.js";
+
+function sizeData(bytes: number): Uint8Array {
+  const data = new Uint8Array(8);
+  new DataView(data.buffer).setFloat64(0, bytes, true);
+  return data;
+}
+
+async function request(
+  fs: InMemoryFs,
+  op: OpCodeType,
+  data: Uint8Array = new Uint8Array(0),
+  flags = 0,
+  path = "/input",
+) {
+  const shared = createSharedBuffer(24);
+  const protocol = new ProtocolBuffer(shared);
+  const handler = new BridgeHandler(shared, fs, "/", "unit");
+  const running = handler.run(1000);
+  try {
+    protocol.setOpCode(op);
+    protocol.setPath(path);
+    protocol.setData(data);
+    protocol.setFlags(flags);
+    protocol.setStatus(Status.READY);
+    protocol.notify();
+    await expect.poll(() => protocol.getStatus()).not.toBe(Status.READY);
+    return {
+      status: protocol.getStatus(),
+      result: protocol.getResultAsString(),
+      sharedBytes: shared.byteLength,
+    };
+  } finally {
+    handler.stop();
+    await running;
+  }
+}
+
+class ValidatedFs extends InMemoryFs {
+  calls: { path: string; bytes: number; op: "read" | "write" }[] = [];
+  reads = 0;
+  limit = 24;
+  async assertFileAccess(path: string, bytes: number, op: "read" | "write") {
+    this.calls.push({ path, bytes, op });
+    if (path.includes("\0")) throw new Error("Invalid path");
+    if (bytes > this.limit) throw new Error("Domain file too large");
+  }
+  override async readFileBuffer(path: string) {
+    this.reads++;
+    return await super.readFileBuffer(path);
+  }
+}
+
+describe("file access intent protocol", () => {
+  it.each([
+    Flags.FILE_ACCESS_READ,
+    Flags.FILE_ACCESS_WRITE,
+  ])("validates an eight-byte extent in a minimum payload (mode %i)", async (flags) => {
+    const fs = new ValidatedFs();
+    expect(
+      await request(fs, OpCode.FILE_ACCESS, sizeData(25), flags),
+    ).toMatchObject({
+      status: Status.ERROR,
+      result: "Domain file too large",
+      sharedBytes: 4152,
+    });
+    expect(fs.calls).toEqual([
+      {
+        path: "/input",
+        bytes: 25,
+        op: flags === Flags.FILE_ACCESS_READ ? "read" : "write",
+      },
+    ]);
+    expect(fs.reads).toBe(0);
+  });
+
