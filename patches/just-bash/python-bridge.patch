+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { Bash } from "../../Bash.js";
+import { InMemoryFs } from "../../fs/in-memory-fs/in-memory-fs.js";
+import type { ExecResult } from "../../types.js";
+
+const state = vi.hoisted(() => ({
+  workers: [] as Array<{ finish(): void }>,
+  allocations: [] as number[],
+  filesystems: [] as object[],
+  holdTermination: false,
+  holdBridge: false,
+  rejectFirstTermination: false,
+  terminationReleases: [] as Array<() => void>,
+  bridgeReleases: [] as Array<() => void>,
+}));
+
+vi.mock("node:worker_threads", () => ({
+  Worker: class {
+    private listeners = new Map<string, Array<(value: unknown) => void>>();
+    private id = state.workers.length;
+    constructor(
+      _path: string,
+      options: { workerData: { protocolToken: string } },
+    ) {
+      state.workers.push({
+        finish: () => {
+          for (const listener of this.listeners.get("message") ?? [])
+            listener({
+              protocolToken: options.workerData.protocolToken,
+              success: true,
+            });
+        },
+      });
+    }
+    on(event: string, listener: (value: unknown) => void): this {
+      this.listeners.set(event, [
+        ...(this.listeners.get(event) ?? []),
+        listener,
+      ]);
+      return this;
+    }
+    removeListener(event: string, listener: (value: unknown) => void): this {
+      this.listeners.set(
+        event,
+        (this.listeners.get(event) ?? []).filter((value) => value !== listener),
+      );
+      return this;
+    }
+    async terminate(): Promise<number> {
+      if (state.rejectFirstTermination && this.id === 0)
+        throw new Error("owned termination refusal");
+      if (state.holdTermination)
+        await new Promise<void>((resolve) =>
+          state.terminationReleases.push(resolve),
+        );
+      return 0;
+    }
+  },
+}));
+
+vi.mock("../worker-bridge/protocol.js", async (original) => {
+  const protocol =
+    await original<typeof import("../worker-bridge/protocol.js")>();
+  return {
+    ...protocol,
+    createSharedBuffer: (bytes: number) => {
+      const buffer = protocol.createSharedBuffer(bytes);
+      state.allocations.push(buffer.byteLength);
+      return buffer;
+    },
+  };
+});
+
+vi.mock("../worker-bridge/bridge-handler.js", () => ({
+  BridgeHandler: class {
+    constructor(_buffer: SharedArrayBuffer, fs: object) {
+      state.filesystems.push(fs);
+    }
+    async run() {
+      if (state.holdBridge)
+        await new Promise<void>((resolve) =>
+          state.bridgeReleases.push(resolve),
+        );
+      return { stdout: "", stderr: "", exitCode: 0 };
+    }
+    stop() {}
+  },
+}));
+
+import { _resetExecutionQueue } from "./python3.js";
+
+const command = "python3 -c 'print(1)'";
+const operations: Promise<ExecResult>[] = [];
+function execute(bash: Bash, script = command) {
+  const operation = bash.exec(script);
+  operations.push(operation);
+  return operation;
+}
+function shell(fs = new InMemoryFs(), defenseInDepth = false) {
+  return new Bash({
+    fs,
+    python: true,
+    defenseInDepth,
+    executionLimits: { maxWorkerMessageBytes: 8192 },
+  });
+}
+async function tick() {
+  await new Promise((resolve) => setTimeout(resolve, 0));
+}
+async function drain() {
+  state.holdTermination = false;
+  state.holdBridge = false;
+  state.rejectFirstTermination = false;
+  for (let index = 0; index < 8; index++) {
+    for (const release of state.terminationReleases.splice(0)) release();
+    for (const release of state.bridgeReleases.splice(0)) release();
+    for (const worker of state.workers) worker.finish();
+    await tick();
+  }
+}
+
+describe("Python stable filesystem admission through Bash", () => {
+  beforeEach(() => {
+    _resetExecutionQueue();
+    state.workers = [];
+    state.allocations = [];
+    state.filesystems = [];
+    state.holdTermination = false;
+    state.holdBridge = false;
+    state.rejectFirstTermination = false;
+    state.terminationReleases = [];
+    state.bridgeReleases = [];
+  });
+  afterEach(async () => {
+    try {
+      await drain();
+    } finally {
+      await Promise.allSettled(operations.splice(0));
+    }
+  });
+
+  it.each([
+    false,
+    true,
+  ])("serializes two fresh command wrappers for the same filesystem (defense %s)", async (defense) => {
+    const fs = new InMemoryFs();
+    const operations = [
+      execute(shell(fs, defense)),
+      execute(shell(fs, defense)),
+    ];
+    await tick();
+    const before = {
+      workers: state.workers.length,
+      buffers: state.allocations.length,
+      bytes: state.allocations.reduce((sum, bytes) => sum + bytes, 0),
+    };
+    await drain();
+    expect(
+      (await Promise.all(operations)).map((result) => result.exitCode),
+    ).toEqual([0, 0]);
+    expect(before).toEqual({ workers: 1, buffers: 1, bytes: 8192 });
+    expect(state.workers).toHaveLength(2);
+    expect(Object.is(state.filesystems[0], state.filesystems[1])).toBe(false);
+  });
+
+  it("keeps two independent filesystem commands concurrent", async () => {
+    const requests = [execute(shell()), execute(shell())];
+    await tick();
+    const before = {
+      workers: state.workers.length,
+      buffers: state.allocations.length,
+      bytes: state.allocations.reduce((sum, bytes) => sum + bytes, 0),
+    };
+    await drain();
+    expect(
+      (await Promise.all(requests)).map((result) => result.exitCode),
+    ).toEqual([0, 0]);
+    expect(before).toEqual({ workers: 2, buffers: 2, bytes: 16384 });
+  });
+
+  it("admits another filesystem past the blocked same-filesystem invocation", async () => {
+    const fs = new InMemoryFs();
+    const operations = [
+      execute(shell(fs)),
+      execute(shell(fs)),
+      execute(shell()),
+    ];
+    await tick();
+    const before = {
+      workers: state.workers.length,
+      buffers: state.allocations.length,
+      bytes: state.allocations.reduce((sum, bytes) => sum + bytes, 0),
+    };
+    await drain();
+    expect(
+      (await Promise.all(operations)).map((result) => result.exitCode),
+    ).toEqual([0, 0, 0]);
+    expect(before).toEqual({ workers: 2, buffers: 2, bytes: 16384 });
+    expect(state.workers).toHaveLength(3);
+  });
+
+  it("holds ownership across sequential commands until termination acknowledges", async () => {
+    state.holdTermination = true;
+    const operation = execute(shell(), `${command}; ${command}`);
+    await tick();
+    state.workers[0]?.finish();
+    await tick();
+    const before = state.workers.length;
+    await drain();
+    expect(await operation).toMatchObject({ exitCode: 0 });
+    expect(before).toBe(1);
+    expect(state.workers).toHaveLength(2);
+  });
+
+  it("holds ownership while a prior bridge is still settling", async () => {
+    state.holdBridge = true;
+    const fs = new InMemoryFs();
+    const first = execute(shell(fs));
+    await tick();
+    state.workers[0]?.finish();
+    await tick();
+    const second = execute(shell(fs));
+    await tick();
+    const before = state.workers.length;
+    await drain();
+    expect(
+      (await Promise.all([first, second])).map((result) => result.exitCode),
+    ).toEqual([0, 0]);
+    expect(before).toBe(1);
+    expect(state.workers).toHaveLength(2);
+  });
+
+  it.each([
+    false,
+    true,
+  ])("retains poison across fresh wrappers without blocking another filesystem (defense %s)", async (defense) => {
+    const fs = new InMemoryFs();
+    state.rejectFirstTermination = true;
+    const first = execute(shell(fs, defense));
+    await tick();
+    state.workers[0]?.finish();
+    expect(await first).toMatchObject({ exitCode: 0 });
+    await tick();
+    const later = execute(shell(fs, defense));
+    const other = execute(shell(new InMemoryFs(), defense));
+    await tick();
+    const before = {
+      workers: state.workers.length,
+      buffers: state.allocations.length,
+      bytes: state.allocations.reduce((sum, bytes) => sum + bytes, 0),
+    };
+    await drain();
+    expect(await later).toMatchObject({
+      exitCode: 1,
+      stderr: "python3: Worker termination was not acknowledged\n",
+    });
+    expect(await other).toMatchObject({ exitCode: 0 });
+    expect(before).toEqual({ workers: 2, buffers: 2, bytes: 16384 });
+    expect(state.workers).toHaveLength(2);
+  });
+});
