+import { AsyncLocalStorage } from "node:async_hooks";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { EMPTY_BYTES } from "../../encoding.js";
+import { InMemoryFs } from "../../fs/in-memory-fs/in-memory-fs.js";
+import type { IFileSystem } from "../../fs/interface.js";
+import { resolveLimits } from "../../limits.js";
+import type { RuntimeCommandContext } from "../../types.js";
+
+const state = vi.hoisted(() => ({
+  workers: [] as Array<{ finish(): void }>,
+  bridgeContexts: [] as Array<string | undefined>,
+  workerContexts: [] as Array<string | undefined>,
+  getTag: () => undefined as string | undefined,
+  constructorThrows: false,
+  allocations: [] as number[],
+  rejectedTerminationOwner: "",
+}));
+vi.mock("node:worker_threads", () => ({
+  Worker: class {
+    private listeners = new Map<string, Array<(value: unknown) => void>>();
+    private readonly owner = state.getTag();
+    constructor(
+      _path: string,
+      options: { workerData: { protocolToken: string } },
+    ) {
+      state.workerContexts.push(state.getTag());
+      if (state.constructorThrows) throw new Error("owned constructor failure");
+      state.workers.push({
+        finish: () => {
+          for (const listener of this.listeners.get("message") ?? [])
+            listener({
+              protocolToken: options.workerData.protocolToken,
+              success: true,
+            });
+        },
+      });
+    }
+    on(event: string, listener: (value: unknown) => void): this {
+      const listeners = this.listeners.get(event) ?? [];
+      listeners.push(listener);
+      this.listeners.set(event, listeners);
+      return this;
+    }
+    removeListener(event: string, listener: (value: unknown) => void): this {
+      this.listeners.set(
+        event,
+        (this.listeners.get(event) ?? []).filter((value) => value !== listener),
+      );
+      return this;
+    }
+    async terminate(): Promise<number> {
+      if (this.owner === state.rejectedTerminationOwner)
+        throw new Error("owned termination failure");
+      return 0;
+    }
+  },
+}));
+vi.mock("../worker-bridge/bridge-handler.js", () => ({
+  BridgeHandler: class {
+    constructor(
+      _buffer: SharedArrayBuffer,
+      private fs: IFileSystem,
+    ) {}
+    async run() {
+      await this.fs.exists("/owned-context-probe");
+      state.bridgeContexts.push(state.getTag());
+      return { stdout: "", stderr: "", exitCode: 0 };
+    }
+    stop() {}
+  },
+}));
+
+vi.mock("../worker-bridge/protocol.js", async (original) => {
+  const protocol =
+    await original<typeof import("../worker-bridge/protocol.js")>();
+  return {
+    ...protocol,
+    createSharedBuffer: (bytes: number) => {
+      const buffer = protocol.createSharedBuffer(bytes);
+      state.allocations.push(buffer.byteLength);
+      return buffer;
+    },
+  };
+});
+
+import { _resetExecutionQueue, python3Command } from "./python3.js";
+
+const tags = new AsyncLocalStorage<string>();
+function context(fs = new InMemoryFs()): RuntimeCommandContext {
+  return {
+    fs,
+    cwd: "/home/user",
+    env: new Map(),
+    stdin: EMPTY_BYTES,
+    limits: resolveLimits({ maxWorkerMessageBytes: 8192 }),
+  };
+}
+function execute(tag: string, fs = new InMemoryFs()) {
+  return tags.run(tag, () =>
+    python3Command.execute(["-c", "print(1)"], context(fs)),
+  );
+}
+async function tick() {
+  await new Promise((resolve) => setTimeout(resolve, 0));
+}
+async function drain() {
+  for (let index = 0; index < 10; index++) {
+    tags.run("release-host", () => {
+      for (const worker of state.workers) worker.finish();
+    });
+    await tick();
+  }
+}
+describe("Python queue capacity boundary", () => {
+  beforeEach(() => {
+    _resetExecutionQueue();
+    state.workers = [];
+    state.bridgeContexts = [];
+    state.workerContexts = [];
+    state.allocations = [];
+    state.getTag = () => tags.getStore();
+    state.constructorThrows = false;
+    state.rejectedTerminationOwner = "";
+  });
+  it("rejects the 101st waiter but dispatches an eligible filesystem past the full blocked queue", async () => {
+    const fs = new InMemoryFs();
+    const first = execute("active", fs);
+    const aborts = Array.from({ length: 100 }, () => new AbortController());
+    const waiting = aborts.map((abort) =>
+      python3Command.execute(["-c", "print(1)"], {
+        ...context(fs),
+        signal: abort.signal,
+      }),
+    );
+    const refused = await execute("refused", fs);
+    const independent = execute("independent");
+    await tick();
+    const beforeRelease = [...state.allocations];
+    for (const abort of aborts) abort.abort();
+    await drain();
+    expect(refused).toMatchObject({
+      exitCode: 1,
+      stdout: "",
+      stderr: "python3: Python execution queue is full\n",
+    });
+    expect(
+      (await Promise.all(waiting)).every((result) => result.exitCode === 124),
+    ).toBe(true);
+    expect(
+      (await Promise.all([first, independent])).map(
+        (result) => result.exitCode,
+      ),
+    ).toEqual([0, 0]);
+    expect(beforeRelease).toEqual([8192, 8192]);
+    expect(state.allocations).toEqual([8192, 8192]);
+    expect(state.workers).toHaveLength(2);
+  });
+  it("never allocates or starts a worker for a pre-aborted request", async () => {
+    const abort = new AbortController();
+    abort.abort();
+    expect(
+      await python3Command.execute(["-c", "print(1)"], {
+        ...context(),
+        signal: abort.signal,
+      }),
+    ).toMatchObject({
+      exitCode: 124,
+      stdout: "",
+      stderr: "python3: Execution aborted\n",
+    });
+    expect(state.allocations).toHaveLength(0);
+    expect(state.workers).toHaveLength(0);
+  });
+
+  it("retains a global reservation after worker termination is unacknowledged", async () => {
+    state.rejectedTerminationOwner = "lost-owner";
+    const lost = execute("lost-owner");
+    await tick();
+    state.workers[0]?.finish();
+    await tick();
+    expect(await lost).toMatchObject({ exitCode: 0 });
+    const operations = Array.from({ length: 5 }, (_, index) =>
+      execute(`replacement-${index}`),
+    );
+    await tick();
+    const beforeRelease = state.allocations.length;
+    await drain();
+    expect(
+      (await Promise.all(operations)).every((result) => result.exitCode === 0),
+    ).toBe(true);
+    expect(beforeRelease).toBe(5);
+    expect(state.workerContexts.slice(1, 5)).toEqual([
+      "replacement-0",
+      "replacement-1",
+      "replacement-2",
+      "replacement-3",
+    ]);
+    expect(state.allocations).toHaveLength(6);
+  });
+
+  it("poisons pending and future requests before a failed worker's bridge finishes", async () => {
+    state.rejectedTerminationOwner = "lost-owner";
+    let release = () => {};
+    const pendingOperation = new Promise<boolean>((resolve) => {
+      release = () => resolve(false);
+    });
+    const fs = new InMemoryFs();
+    fs.exists = () => pendingOperation;
+    const lost = execute("lost-owner", fs);
+    const waiting = execute("waiting-owner", fs);
+    await tick();
+    state.workers[0]?.finish();
+    await tick();
+    const queued = await waiting;
+    const future = await execute("future-owner", fs);
+    release();
+    await drain();
+    expect(await lost).toMatchObject({ exitCode: 0 });
+    expect(queued).toMatchObject({
+      exitCode: 1,
+      stderr: "python3: Worker termination was not acknowledged\n",
+    });
+    expect(future).toMatchObject({
+      exitCode: 1,
+      stderr: "python3: Worker termination was not acknowledged\n",
+    });
+    expect(state.allocations).toEqual([8192]);
+    expect(state.workers).toHaveLength(1);
+  });
+});
