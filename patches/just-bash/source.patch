+import { describe, expect, it } from "vitest";
+import {
+  createSharedBuffer,
+  ErrorCode,
+  ProtocolBuffer,
+  SHARED_BUFFER_OVERHEAD,
+} from "./protocol.js";
+
+describe("shared bridge capacity", () => {
+  it.each([
+    24, 25,
+  ])("preserves an error header and valid UTF-8 within %i bytes", (capacity) => {
+    const shared = createSharedBuffer(capacity);
+    const sender = new ProtocolBuffer(shared);
+    const receiver = new ProtocolBuffer(shared);
+    sender.setErrorCode(ErrorCode.NOT_FOUND);
+    sender.setErrorResultFromString(`${"🐙".repeat(40)} no such file`);
+    expect(receiver.getErrorCode()).toBe(ErrorCode.NOT_FOUND);
+    expect(receiver.getResultAsString()).toContain("No such file");
+    expect(receiver.getResultAsString()).not.toContain("\ufffd");
+    expect(receiver.getResult().length).toBeLessThanOrEqual(capacity);
+    sender.setErrorResultFromString("ordinary error");
+    expect(receiver.getResultAsString()).toBe("ordinary error");
+    expect(() => sender.setResultFromString("🐙".repeat(40))).toThrow(
+      "Result too large",
+    );
+  });
+
+  it("preserves an unaligned configured byte capacity in both directions", () => {
+    const shared = createSharedBuffer(8193);
+    const sender = new ProtocolBuffer(shared);
+    const receiver = new ProtocolBuffer(shared);
+    const data = new Uint8Array(8193).fill(0x5a);
+    expect(shared.byteLength).toBe(SHARED_BUFFER_OVERHEAD + data.length);
+    sender.setData(data);
+    expect(receiver.getData()).toEqual(data);
+    receiver.setResult(data);
+    expect(sender.getResult()).toEqual(data);
+    expect(() => sender.setData(new Uint8Array(8194))).toThrow(
+      "Data too large",
+    );
+    expect(() => receiver.setResult(new Uint8Array(8194))).toThrow(
+      "Result too large",
+    );
+  });
+
+  it.each([
+    [2, -1],
+    [2, 4097],
+    [3, -1],
+    [3, 8194],
+    [4, -1],
+    [4, 8194],
+  ])("rejects an invalid length at control word %i with value %i", (index, length) => {
+    const shared = createSharedBuffer(8193);
+    const protocol = new ProtocolBuffer(shared);
+    Atomics.store(new Int32Array(shared, 0, 8), index, length);
+    const read =
+      index === 2
+        ? () => protocol.getPath()
+        : index === 3
+          ? () => protocol.getData()
+          : () => protocol.getResult();
+    expect(read).toThrow("Invalid bridge length");
+  });
+
+  it.each([
+    0,
+    23,
+    -1,
+    1.5,
+    Number.POSITIVE_INFINITY,
+    0x80000000,
+  ])("rejects an invalid allocation capacity %s", (capacity) =>
+    expect(() => createSharedBuffer(capacity)).toThrow(
+      "Invalid shared bridge payload capacity",
+    ));
+});
