diff --git a/packages/just-bash/src/commands/python3/python3.bridge-admission.test.ts b/packages/just-bash/src/commands/python3/python3.bridge-admission.test.ts
new file mode 100644
index 0000000..3a26128
--- /dev/null
+++ b/packages/just-bash/src/commands/python3/python3.bridge-admission.test.ts
@@ -0,0 +1,268 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { Bash } from "../../Bash.js";
+import { EMPTY_BYTES } from "../../encoding.js";
+import { InMemoryFs } from "../../fs/in-memory-fs/in-memory-fs.js";
+import { resolveLimits } from "../../limits.js";
+import type { RuntimeCommandContext } from "../../types.js";
+
+const state = vi.hoisted(() => ({
+  allocations: [] as number[],
+  workers: [] as Array<{ finish(): void }>,
+  holdTermination: false,
+  holdBridge: false,
+  terminationReleases: [] as Array<() => void>,
+  bridgeReleases: [] as Array<() => void>,
+}));
+
+vi.mock("node:worker_threads", () => ({
+  Worker: class {
+    private listeners = new Map<string, Array<(value: unknown) => void>>();
+    constructor(
+      _path: string,
+      options: { workerData: { protocolToken: string } },
+    ) {
+      state.workers.push({
+        finish: () => {
+          for (const listener of this.listeners.get("message") ?? []) {
+            listener({
+              protocolToken: options.workerData.protocolToken,
+              success: true,
+            });
+          }
+        },
+      });
+    }
+    on(event: string, listener: (value: unknown) => void): this {
+      const listeners = this.listeners.get(event) ?? [];
+      listeners.push(listener);
+      this.listeners.set(event, listeners);
+      return this;
+    }
+    removeListener(event: string, listener: (value: unknown) => void): this {
+      this.listeners.set(
+        event,
+        (this.listeners.get(event) ?? []).filter((value) => value !== listener),
+      );
+      return this;
+    }
+    async terminate(): Promise<number> {
+      if (state.holdTermination)
+        await new Promise<void>((resolve) =>
+          state.terminationReleases.push(resolve),
+        );
+      return 0;
+    }
+  },
+}));
+
+vi.mock("../worker-bridge/protocol.js", async (original) => {
+  const protocol =
+    await original<typeof import("../worker-bridge/protocol.js")>();
+  return {
+    ...protocol,
+    createSharedBuffer: (bytes: number) => {
+      const buffer = protocol.createSharedBuffer(bytes);
+      state.allocations.push(buffer.byteLength);
+      return buffer;
+    },
+  };
+});
+
+vi.mock("../worker-bridge/bridge-handler.js", () => ({
+  BridgeHandler: class {
+    async run() {
+      if (state.holdBridge)
+        await new Promise<void>((resolve) =>
+          state.bridgeReleases.push(resolve),
+        );
+      return { stdout: "", stderr: "", exitCode: 0 };
+    }
+    stop() {}
+  },
+}));
+
+import { _resetExecutionQueue, python3Command } from "./python3.js";
+
+function context(
+  fs = new InMemoryFs(),
+  messageBytes = 64 * 1024 * 1024,
+): RuntimeCommandContext {
+  return {
+    fs,
+    cwd: "/home/user",
+    env: new Map(),
+    stdin: EMPTY_BYTES,
+    limits: resolveLimits({ maxWorkerMessageBytes: messageBytes }),
+  };
+}
+
+async function tick(): Promise<void> {
+  await new Promise((resolve) => setTimeout(resolve, 0));
+}
+async function drain(): Promise<void> {
+  state.holdTermination = false;
+  state.holdBridge = false;
+  for (let index = 0; index < 10; index++) {
+    for (const release of state.terminationReleases.splice(0)) release();
+    for (const release of state.bridgeReleases.splice(0)) release();
+    for (const worker of state.workers) worker.finish();
+    await tick();
+  }
+}
+
+describe("Python bridge allocation admission", () => {
+  beforeEach(() => {
+    _resetExecutionQueue();
+    state.allocations = [];
+    state.workers = [];
+    state.holdTermination = false;
+    state.holdBridge = false;
+    state.terminationReleases = [];
+    state.bridgeReleases = [];
+  });
+
+  it("preserves the historical default 8 MiB payload allocation", async () => {
+    const operation = python3Command.execute(["-c", "print(1)"], context());
+    await tick();
+    const measured = [...state.allocations];
+    await drain();
+    expect(await operation).toMatchObject({ exitCode: 0 });
+    expect(measured).toEqual([8 * 1024 * 1024 + 4128]);
+  });
+
+  it("allocates no bridge for a queued or cancelled same-filesystem command", async () => {
+    const fs = new InMemoryFs();
+    const abort = new AbortController();
+    const first = python3Command.execute(["-c", "print(1)"], context(fs));
+    const second = python3Command.execute(["-c", "print(2)"], {
+      ...context(fs),
+      signal: abort.signal,
+    });
+    await tick();
+    const measured = [...state.allocations];
+    abort.abort();
+    await drain();
+    expect(await first).toMatchObject({ exitCode: 0 });
+    expect(await second).toMatchObject({ exitCode: 124 });
+    expect(measured).toHaveLength(1);
+    expect(state.allocations).toHaveLength(1);
+  });
+
+  it("bounds active buffers across independent filesystems before allocating the sixth", async () => {
+    const operations = Array.from({ length: 6 }, () =>
+      python3Command.execute(
+        ["-c", "print(1)"],
+        context(new InMemoryFs(), 8192),
+      ),
+    );
+    await tick();
+    const beforeRelease = [...state.allocations];
+    const workersBeforeRelease = state.workers.length;
+    await drain();
+    expect(
+      (await Promise.all(operations)).every((result) => result.exitCode === 0),
+    ).toBe(true);
+    expect(beforeRelease).toHaveLength(5);
+    expect(workersBeforeRelease).toBe(5);
+    expect(state.allocations).toHaveLength(6);
+  });
+
+  it.each([
+    "termination",
+    "bridge",
+  ])("holds filesystem ownership until %s settles", async (held) => {
+    const fs = new InMemoryFs();
+    state.holdTermination = held === "termination";
+    state.holdBridge = held === "bridge";
+    const first = python3Command.execute(["-c", "print(1)"], context(fs, 8192));
+    const second = python3Command.execute(
+      ["-c", "print(2)"],
+      context(fs, 8192),
+    );
+    await tick();
+    state.workers[0]?.finish();
+    await tick();
+    const workersBeforeSettlement = state.workers.length;
+    const buffersBeforeSettlement = state.allocations.length;
+    await drain();
+    expect(
+      (await Promise.all([first, second])).map((result) => result.exitCode),
+    ).toEqual([0, 0]);
+    expect(workersBeforeSettlement).toBe(1);
+    expect(buffersBeforeSettlement).toBe(1);
+    expect(state.workers).toHaveLength(2);
+  });
+
+  it("allows another filesystem to dispatch past a blocked queue head", async () => {
+    const fs = new InMemoryFs();
+    const operations = [
+      python3Command.execute(["-c", "print(1)"], context(fs, 8192)),
+      python3Command.execute(["-c", "print(2)"], context(fs, 8192)),
+      python3Command.execute(
+        ["-c", "print(3)"],
+        context(new InMemoryFs(), 8192),
+      ),
+    ];
+    await tick();
+    const beforeRelease = state.workers.length;
+    await drain();
+    expect(
+      (await Promise.all(operations)).map((result) => result.exitCode),
+    ).toEqual([0, 0, 0]);
+    expect(beforeRelease).toBe(2);
+    expect(state.allocations).toHaveLength(3);
+  });
+
+  it("expires a waiting request without allocating or dispatching it later", async () => {
+    const fs = new InMemoryFs();
+    const first = python3Command.execute(["-c", "print(1)"], context(fs, 8192));
+    const second = python3Command.execute(["-c", "print(2)"], {
+      ...context(fs, 8192),
+      limits: resolveLimits({
+        maxPythonTimeoutMs: 5,
+        maxWorkerMessageBytes: 8192,
+      }),
+    });
+    const secondResult = await second;
+    const beforeRelease = state.allocations.length;
+    await drain();
+    expect(await first).toMatchObject({ exitCode: 0 });
+    expect(secondResult).toMatchObject({
+      exitCode: 124,
+      stdout: "",
+      stderr: "python3: Execution timeout: exceeded 5ms limit\n",
+    });
+    expect(beforeRelease).toBe(1);
+    expect(state.allocations).toHaveLength(1);
+  });
+
+  it.each([
+    24,
+    1024,
+    8 * 1024 * 1024,
+    64 * 1024 * 1024 - 4128,
+  ])("uses an explicit %i byte bridge payload independently of the string ceiling", async (capacity) => {
+    const ctx = context();
+    ctx.limits = { ...resolveLimits(), maxPythonBridgeBytes: capacity };
+    const operation = python3Command.execute(["-c", "print(1)"], ctx);
+    await drain();
+    expect(await operation).toMatchObject({ exitCode: 0 });
+    expect(state.allocations).toEqual([capacity + 4128]);
+  });
+
+  it("admits dynamically named pipeline stages before allocating their bridges", async () => {
+    const bash = new Bash({
+      python: true,
+      executionLimits: { maxWorkerMessageBytes: 8192 },
+    });
+    const operation = bash.exec(
+      `command=py; command=\${command}thon3; $command -c 'print(1)' | $command -c 'print(2)' | $command -c 'print(3)'`,
+    );
+    await tick();
+    const beforeRelease = state.allocations.length;
+    await drain();
+    expect(await operation).toMatchObject({ exitCode: 0 });
+    expect(beforeRelease).toBe(1);
+    expect(state.allocations).toHaveLength(3);
+  });
+});
