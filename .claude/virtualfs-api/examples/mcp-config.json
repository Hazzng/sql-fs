{
	"_comment": "Add the 'virtualfs' block to the mcpServers section of ~/.claude/settings.json",
	"_docs": "https://virtualfs-api.redocean-7a422dd7.australiaeast.azurecontainerapps.io/docs",
	"_tools": ["sandbox_create", "sandbox_delete", "bash_exec", "fs_ingest", "fs_export"],

	"mcpServers": {
		"virtualfs": {
			"type": "http",
			"url": "https://virtualfs-api.redocean-7a422dd7.australiaeast.azurecontainerapps.io/mcp",
			"headers": {
				"Authorization": "Bearer <YOUR_TOKEN_HERE>"
			}
		}
	},

	"_tool_descriptions": {
		"sandbox_create": {
			"args": { "python": "boolean (optional)", "javascript": "boolean (optional)" },
			"returns": "{ id, python, javascript }",
			"note": "Runtimes must be declared at creation — cannot change after"
		},
		"sandbox_delete": {
			"args": { "id": "string" },
			"returns": "{ ok: true } | { ok: false, error: string }"
		},
		"bash_exec": {
			"args": { "id": "string", "script": "string", "timeout": "number (optional, ms, max 300000)" },
			"returns": "{ stdout, stderr, exitCode }",
			"note": "Default timeout 30s. Shell state (env, cwd) persists between calls on same sandbox."
		},
		"fs_ingest": {
			"args": {
				"id": "string",
				"basePath": "string (optional, default /home/user)",
				"files": "Record<relativePath, plainTextContent>"
			},
			"returns": "{ ok: true, count: N }",
			"note": "Values are plain text (NOT base64) — MCP tool differs from HTTP ingest-files endpoint"
		},
		"fs_export": {
			"args": {
				"id": "string",
				"basePath": "string (optional, default /home/user)"
			},
			"returns": "{ files: Record<relativePath, string>, errors?: string[] }",
			"note": "Binary files are returned as data:application/octet-stream;base64,... URIs"
		}
	},

	"_example_workflow": [
		"1. sandbox_create({}) → { id: 'abc-123' }",
		"2. fs_ingest({ id, basePath: '/home/user/project', files: { 'index.ts': 'console.log(1)' } })",
		"3. bash_exec({ id, script: 'cat /home/user/project/index.ts' })",
		"4. bash_exec({ id, script: 'grep -rn export /home/user/project' })",
		"5. fs_export({ id, basePath: '/home/user/project' }) → { files: {...} }",
		"6. sandbox_delete({ id })"
	]
}
