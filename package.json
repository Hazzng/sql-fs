{
	"name": "sql-fs-api",
	"version": "1.2.1",
	"description": "Persistent filesystem backend (Postgres) + HTTP/MCP API for just-bash sandboxes",
	"type": "module",
	"license": "MIT",
	"author": "Harry Nguyen",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"setup:dev": "pnpm install --frozen-lockfile && pnpm --dir clients/typescript install --ignore-workspace --frozen-lockfile && uv sync --project clients/python --locked --extra dev",
		"check": "pnpm typecheck && pnpm lint && pnpm check:architecture && pnpm check:scripts && pnpm test:unit && pnpm build && pnpm check:typescript && pnpm check:python",
		"check:architecture": "node scripts/check-architecture-boundaries.mjs",
		"check:scripts": "bash -n scripts/check-python.sh && bash -n scripts/check-python-types.sh && bash -n scripts/verify-local.sh && node --test scripts/*.test.mjs scripts/verify/*.test.mjs",
		"check:typescript": "pnpm --dir clients/typescript typecheck && pnpm --dir clients/typescript test && pnpm --dir clients/typescript build",
		"check:python": "bash scripts/check-python.sh",
		"check:python:types": "bash scripts/check-python-types.sh",
		"verify:local": "bash scripts/verify-local.sh",
		"verify:architecture": "bash scripts/verify-local.sh architecture",
		"security:audit": "pnpm audit --prod --audit-level=high",
		"dev": "tsx watch --env-file .env src/api/server.ts",
		"dev:portless": "portless",
		"build": "tsc && node scripts/copy-postgres-migrations.mjs",
		"start": "node dist/api/server.js",
		"bench:remote-bash": "python3 scripts/benchmark_remote_bash.py",
		"typecheck": "tsc --noEmit",
		"lint": "pnpm lint:biome && pnpm lint:oxlint",
		"lint:fix": "biome check --write --error-on-warnings . && pnpm lint:oxlint",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run --exclude 'src/**/integration/**'",
		"test:integration": "vitest run --no-file-parallelism /integration/",
		"test:comparison": "vitest run --config vitest.comparison.config.ts",
		"db:gc": "tsx src/api/cli/gc.ts",
		"token:create": "tsx src/api/cli/token.ts",
		"changeset": "changeset",
		"changeset:version": "changeset version && node scripts/sync-openapi-version.mjs && pnpm install --lockfile-only",
		"prepare": "lefthook install",
		"lint:biome": "biome check --error-on-warnings .",
		"lint:oxlint": "pnpm lint:oxlint:syntax && pnpm lint:oxlint:types",
		"lint:oxlint:syntax": "NODE_OPTIONS=--import=tsx oxlint --deny-warnings .",
		"lint:oxlint:types": "NODE_OPTIONS=--import=tsx oxlint -c .oxlintrc-type-aware.json --deny-warnings src clients/typescript"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.17",
		"@hono/swagger-ui": "^0.6.1",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"async-mutex": "^0.5.0",
		"hono": "^4.13.13",
		"ioredis": "^5.4.0",
		"jose": "^6.2.12",
		"just-bash": "^3.6.0",
		"just-git": "^1.10.0",
		"lru-cache": "^11.0.0",
		"postgres": "^3.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@oxlint/plugins": "1.87.0",
		"@types/node": "^22.0.0",
		"ajv": "^8.18.0",
		"ajv-formats": "^3.0.1",
		"knip": "^6.4.1",
		"lefthook": "^1.11.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2004",
		"portless": "^0.13.0",
		"tsx": "^4.23.15",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
