{
	"$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"files": {
		"ignore": [
			"node_modules",
			"dist",
			".tmp",
			"*.sql",
			"scripts",
			"clients/python/.venv",
			"thoughts",
			"vendor",
			"src/pyodide-runner/runner.ts"
		]
	}
}
